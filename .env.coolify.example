# ==============================================================================
# QuickVoice - Coolify Deployment Environment Configuration Template
# ==============================================================================
# Copy these environment variables into Coolify's Environment Variables panel.
# Replace placeholder values (yourdomain.com, secrets) with your actual settings.
# OPTIONAL vars can be left blank if you don't use that provider.

# ------------------------------------------------------------------------------
# 1. Domain & URL Configuration (Set to your actual public domains in Coolify)
# ------------------------------------------------------------------------------
SERVER_URL=https://web.cochindigitalsystem.com
CONSOLE_URL=https://app.cochindigitalsystem.com
LANDING_URL=https://cochindigitalsystem.com

# ------------------------------------------------------------------------------
# 2. Database & Cache Connection Strings
# ------------------------------------------------------------------------------
# Connect directly to your existing PostgreSQL and Redis:
# If running in Coolify: use internal hostnames, e.g.:
# DATABASE_URL=postgresql://quickvoice:YOUR_PASSWORD@quickvoice-postgresql:5432/quickvoice
# If running on VPS host directly: use host.docker.internal:
DATABASE_URL=postgresql://quickvoice:YOUR_POSTGRES_PASSWORD@host.docker.internal:5432/quickvoice
REDIS_URL=redis://host.docker.internal:6379

# ------------------------------------------------------------------------------
# 3. Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32 (MUST be at least 32 characters long)
BETTER_AUTH_SECRET=generate_a_secure_32_character_random_string_here
INTERNAL_API_KEY=generate_a_secure_internal_cluster_api_key_here

# Set to false to allow login/registration without configuring SMTP email service
REQUIRE_EMAIL_VERIFICATION=false

# ------------------------------------------------------------------------------
# 4. Port Mappings (Defaults)
# ------------------------------------------------------------------------------
SERVER_PORT=5000
CONSOLE_PORT=3000
WEB_PORT=3001
AI_PORT=5555
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ------------------------------------------------------------------------------
# 5. LiveKit (Required — Server or Cloud)
# ------------------------------------------------------------------------------
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Optional: LiveKit SIP Trunk IDs (created in LiveKit CLI / Console for telephony)
LIVEKIT_SIP_INBOUND_TRUNK_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_TWILIO_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_TELNYX_ID=
LIVEKIT_SIP_OUTBOUND_TRUNK_VOBIZ_ID=

# ------------------------------------------------------------------------------
# 6. Speech-To-Text (STT) Providers
# Uncomment / fill in the provider(s) you want to use.
# ------------------------------------------------------------------------------

# Deepgram (Default STT — Nova-3 / Nova-3 Multilingual)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Sarvam AI (Best for Indian languages: Hindi, Tamil, Telugu, Kannada, Malayalam)
SARVAM_API_KEY=

# OpenAI Whisper (multilingual, high accuracy)
# OPENAI_API_KEY is shared with OpenAI LLM below — set it once.

# ------------------------------------------------------------------------------
# 7. Text-To-Speech (TTS) Providers
# ------------------------------------------------------------------------------

# ElevenLabs (Ultra-realistic voices, multilingual)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Cartesia (Sonic-2 — low-latency, multilingual)
CARTESIA_API_KEY=

# Deepgram Aura-2 (Default TTS — uses DEEPGRAM_API_KEY above)

# ------------------------------------------------------------------------------
# 8. LLM Brain Providers (all pure API — no local model downloads required)
# ------------------------------------------------------------------------------

# OpenAI (GPT-4o, GPT-4o-mini, GPT-4.1-mini — also used for Whisper STT)
OPENAI_API_KEY=

# Groq (Ultra-fast inference: Llama 3.3 70B, Llama 3.1 8B, Gemma 2 9B)
GROQ_API_KEY=

# DeepSeek (DeepSeek-Chat V3, DeepSeek-Reasoner R1)
DEEPSEEK_API_KEY=

# AWS Bedrock (Default LLM: Claude Haiku 4.5, Claude Sonnet 4.5, Amazon Nova)
# Also used for S3 audio recording storage if S3_BUCKET_NAME is set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ------------------------------------------------------------------------------
# 9. Telephony Providers (SIP / Phone Numbers) — Optional
# Configure ONE or MORE of the following telephony providers.
# ------------------------------------------------------------------------------

# Telnyx (SIP trunking + DID number purchase)
TELNYX_API_KEY=

# Twilio (Voice API + DID number purchase)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Vobiz (SIP Trunking via LiveKit — Indian & international DIDs)
# Get credentials at https://vobiz.ai → Settings → API Keys
# Base URL: https://api.vobiz.ai/api
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 10. Billing & Subscriptions (Stripe) — Optional
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 11. S3 Storage (Audio Call Recordings & Transcripts) — Optional
# Works with MinIO (Self-Hosted), Cloudflare R2, AWS S3, Wasabi, DigitalOcean.
# ------------------------------------------------------------------------------
# If using the self-hosted MinIO service from docker-compose:
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_pass

# Point QuickVoice to MinIO (or leave blank to disable S3 storage):
S3_BUCKET_NAME=quickvoice
S3_ENDPOINT=http://minio:9000
S3_FORCE_PATH_STYLE=true
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secure_pass
AWS_REGION=us-east-1

# (Alternative) If using Cloudflare R2 instead of MinIO:
# S3_BUCKET_NAME=quickvoice-recordings
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID=<your_r2_access_key>
# AWS_SECRET_ACCESS_KEY=<your_r2_secret_key>
# AWS_REGION=auto

