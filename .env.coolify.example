# ==============================================================================
# QuickVoice - Coolify Deployment Environment Configuration Template
# ==============================================================================
# Copy these environment variables into Coolify's Environment Variables panel.
# Replace placeholder values (yourdomain.com, secrets) with your actual settings.

# ------------------------------------------------------------------------------
# 1. Domain & URL Configuration (Set to your actual public domains in Coolify)
# ------------------------------------------------------------------------------
SERVER_URL=https://api.yourdomain.com
CONSOLE_URL=https://app.yourdomain.com
LANDING_URL=https://yourdomain.com

# ------------------------------------------------------------------------------
# 2. Database & Cache Credentials
# ------------------------------------------------------------------------------
POSTGRES_USER=quickvoice
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=quickvoice

# ------------------------------------------------------------------------------
# 3. Security & Authentication Secrets
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32 (MUST be at least 32 characters long)
BETTER_AUTH_SECRET=generate_a_secure_32_character_random_string_here
INTERNAL_API_KEY=generate_a_secure_internal_cluster_api_key_here

# ------------------------------------------------------------------------------
# 4. Port Mappings (Defaults)
# ------------------------------------------------------------------------------
SERVER_PORT=5000
CONSOLE_PORT=3000
WEB_PORT=3001
AI_PORT=5555

# ------------------------------------------------------------------------------
# 5. Voice & AI Providers (Required for Live Agent Voice Calls)
# ------------------------------------------------------------------------------
# LiveKit Cloud or Self-Hosted LiveKit Server
LIVEKIT_URL=wss://your-livekit-server.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Speech-To-Text & Text-To-Speech Providers
DEEPGRAM_API_KEY=your_deepgram_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# LLM Providers (OpenAI / Groq)
OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key

# ------------------------------------------------------------------------------
# 6. Telephony Integration (SIP / Phone Numbers) - Optional
# ------------------------------------------------------------------------------
TELNYX_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 7. Billing & Subscriptions (Stripe) - Optional
# ------------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ------------------------------------------------------------------------------
# 8. S3 Storage (Audio Call Recordings & Transcripts) - Optional
# ------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
